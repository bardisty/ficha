* text=auto eol=lf

# Golden snapshots are compared byte-for-byte against rendered output, which
# always uses LF and may carry trailing spaces and ANSI escapes. Git must never
# rewrite them, whatever core.autocrlf says on a Windows checkout. The padding
# is part of the output, so git diff --check shouldn't flag it either.
*.golden -text -whitespace

*.webp binary
